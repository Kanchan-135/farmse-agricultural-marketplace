# FarmSe Backend Environment Variables

PORT=5000
NODE_ENV=production

# Production PostgreSQL Database URL (from Neon.tech)
# Example: postgresql://username:password@ep-green-hill.us-east-2.aws.neon.tech/farmse?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farmse_db?schema=public"

# JWT Auth Secret
JWT_SECRET=your_ultra_secure_jwt_random_secret_string_here
JWT_EXPIRES_IN=7d

# Allowed Frontend URL & CORS Origins (comma-separated or single domain)
FRONTEND_URL=https://farmse.vercel.app
CORS_ORIGIN=https://farmse.vercel.app,http://localhost:5173,capacitor://localhost,http://localhost
CLIENT_URL=https://farmse.vercel.app
