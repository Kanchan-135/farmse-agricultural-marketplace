{
  "name": "FarmSe - Direct Agricultural Marketplace",
  "short_name": "FarmSe",
  "description": "Direct farm-to-table agricultural marketplace connecting verified regional farmers and conscious consumers across India with zero middlemen.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "window-controls-overlay"
  ],
  "orientation": "portrait-primary",
  "background_color": "#064e3b",
  "theme_color": "#047857",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "shopping",
    "agriculture",
    "business",
    "food"
  ],
  "icons": [
