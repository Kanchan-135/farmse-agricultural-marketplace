  "screenshots": [
    {
      "src": "/icons/screenshot-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "FarmSe Mobile Marketplace"
    },
    {
      "src": "/icons/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "FarmSe Agricultural Marketplace Desktop & Tablet"
    }
  ],
  "shortcuts": [
    {
      "name": "Marketplace",
      "short_name": "Market",
      "description": "Browse today's direct farm harvest produce",
      "url": "/marketplace?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My Orders",
      "short_name": "Orders",
      "description": "Track your active farm orders & deliveries",
      "url": "/customer/orders?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Farmer Hub",
      "short_name": "Farmer",
      "description": "Manage harvest listings and incoming orders",
      "url": "/farmer/dashboard?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Shopping Cart",
      "short_name": "Cart",
      "description": "View your farm basket items",
      "url": "/cart?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
